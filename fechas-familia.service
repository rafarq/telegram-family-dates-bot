[Unit]
Description=Bot de Telegram Familia para fechas importantes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/fechas-familia-bot
ExecStart=%h/workspace/fechas-familia-bot/.venv/bin/python bot.py
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/workspace/fechas-familia-bot/.env
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
